(set-logic QF_LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(declare-var i1 Int)
(declare-var j1 Int)

(define-proc
  main
  ()
  ((result Int))
  ((n0 Int) (n1 Int) (i0 Int) (k Int))
  (!
    (sequence
      (assign (i0 0))
      (assign (k 0))
      (havoc n0)
      (havoc n1)
      (if
        (not
          (and (<= (- 1000000) n0) (< n0 1000000)))
        (sequence (assign (result 0)) (return)))
      (if
        (not
          (and (<= (- 1000000) n1) (< n1 1000000)))
        (sequence (assign (result 0)) (return)))
      (!
        (while
          (< i0 n0)
          (sequence (assign (i0 (+ i0 1))) (assign (k (+ k 1)))))
        :tag
        main-while-1)
      (assign (i1 0))
      (!
        (while
          (< i1 n1)
          (sequence (assign (i1 (+ i1 1))) (assign (k (+ k 1)))))
        :tag
        main-while-2)
      (assign (j1 0))
      (!
        (while
          (< j1 (+ n0 n1))
          (sequence
            (! (sequence) :tag main-check-1)
            (assign (j1 (+ j1 1)))
            (assign (k (- k 1)))))
        :tag
        main-while-3))
    :tag
    main))

(annotate-tag main-check-1 :check-true (< 0 k))

(verify-call main ())

(get-witness)
