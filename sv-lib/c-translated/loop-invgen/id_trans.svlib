(define-proc
  main
  ()
  ((result Int))
  ((idBitLength Int)
    (material_length Int)
    (nlen Int)
    (j Int)
    (k Int))
  (sequence
    (havoc (nlen))
    (havoc (idBitLength))
    (havoc (material_length))
    (if
      (not
        (= nlen (div idBitLength 32)))
      (sequence
        (assign ((result 0)))
        (return)))
    (assign ((j 0)))
    (while
      (and
        (< j (div idBitLength 8))
        (< j material_length))
      (sequence
        (assert (<= 0 j))
        (assert
          (< j material_length))
        (assert (<= 0 (div j 4)))
        (assert (< (div j 4) nlen))
        (assign ((j (+ j 1))))))
    (assign ((result 0)))
    (return)))
