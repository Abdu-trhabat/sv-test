(define-proc
  main
  ()
  ((result Int))
  ((offset Int) (length Int) (nlen Int) (i Int) (j Int))
  (sequence
    (assign ((i 0)))
    (while
      (< i nlen)
      (sequence
        (assign ((j 0)))
        (while
          (< j 8)
          (sequence
            (assert
              (<= 0 (- (- nlen 1) i)))
            (assert
              (< (- (- nlen 1) i) nlen))
            (assign ((j (+ j 1))))))
        (assign ((i (+ i 1))))))
    (assign ((result 0)))
    (return)))
