(define-proc
  main
  ()
  ((result Int))
  ((n Int) (k Int) (i Int))
  (sequence
    (assign ((k 0)))
    (assign ((i 0)))
    (havoc (n))
    (while
      (< i n)
      (sequence
        (assign ((i (+ i 1))))
        (assign ((k (+ k 1))))))
    (assign ((j n)))
    (while
      (< 0 j)
      (sequence
        (assert (< 0 k))
        (assign ((j (- j 1))))
        (assign ((k (- k 1))))))
    (assign ((result 0)))
    (return)))
