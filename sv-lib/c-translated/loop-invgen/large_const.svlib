(set-logic QF_LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((c1 Int) (c2 Int) (c3 Int) (n Int) (v Int) (i Int) (k Int) (j Int))
  (!
    (sequence
      (assign (c1 4000))
      (assign (c2 2000))
      (assign (c3 10000))
      (havoc n)
      (if (not (and (<= 0 n) (< n 10))) (sequence (assign (result 0)) (return)))
      (assign (k 0))
      (assign (i 0))
      (!
        (while
          (< i n)
          (sequence
            (assign (i (+ i 1)))
            (havoc v)
            (if (not (and (<= 0 v) (< n 2))) (sequence (assign (result 0)) (return)))
            (if
              (= v 0)
              (assign (k (+ k c1)))
              (if (= v 1) (assign (k (+ k c2))) (assign (k (+ k c3)))))))
        :tag
        main-while-1)
      (assign (j 0))
      (!
        (while
          (< j n)
          (sequence
            (! (sequence) :tag main-check-1)
            (assign (j (+ j 1)))
            (assign (k (- k 1)))))
        :tag
        main-while-2)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (< 0 k))

(verify-call main ())

(get-witness)
