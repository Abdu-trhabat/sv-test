(define-proc
  main
  ()
  ((result Int))
  ((n Int) (i Int) (k Int))
  (sequence
    (assign ((i 0)))
    (assign ((k 0)))
    (havoc (n))
    (while
      (< i n)
      (sequence
        (assign ((i (+ i 1))))
        (assign ((k (+ k 1))))))
    (assign ((j 0)))
    (while
      (< j n)
      (sequence
        (assert (< 0 k))
        (assign ((j (+ j 1))))
        (assign ((k (- k 1))))))))
