(set-logic QF_LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(declare-var nondet_int$2 Int)

(define-proc
  main
  ()
  ((result Int))
  ((i Int) (k Int) (n Int) (l Int))
  (!
    (sequence
      (havoc n)
      (havoc l)
      (if (not (< 0 l)) (sequence (assign (result 0)) (return)))
      (if (not (< l 1000000)) (sequence (assign (result 0)) (return)))
      (if (not (< n 1000000)) (sequence (assign (result 0)) (return)))
      (assign (k 1))
      (!
        (while
          (< k n)
          (sequence
            (assign (i l))
            (!
              (while
                (< i n)
                (sequence (! (sequence) :tag main-check-1) (assign (i (+ i 1)))))
              :tag
              main-while-2)
            (if (not (= nondet_int$2 0)) (assign (l (+ l 1))))
            (assign (k (+ k 1)))))
        :tag
        main-while-1))
    :tag
    main))

(annotate-tag main-check-1 :check-true (<= 1 i))

(verify-call main ())

(get-witness)
