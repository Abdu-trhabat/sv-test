(define-proc
  main
  ()
  ((result Int))
  ((i Int) (k Int) (n Int) (l Int))
  (sequence
    (havoc (n))
    (havoc (l))
    (if
      (not (< 0 l))
      (sequence
        (assign ((result 0)))
        (return)))
    (if
      (not (< l 1000000))
      (sequence
        (assign ((result 0)))
        (return)))
    (if
      (not (< n 1000000))
      (sequence
        (assign ((result 0)))
        (return)))
    (assign ((k 1)))
    (while
      (< k n)
      (sequence
        (assign ((i l)))
        (while
          (< i n)
          (sequence
            (assert (<= 1 i))
            (assign ((i (+ i 1))))))
        (if
          (not (= nondet_int$2 0))
          (assign ((l (+ l 1)))))
        (assign ((k (+ k 1))))))))
