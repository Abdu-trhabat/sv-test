(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (sequence
    (assign ((x 0)))
    (while
      (< x 99)
      (sequence
        (if
          (= (mod y 2) 0)
          (assign ((x (+ x 2))))
          (assign ((x (+ x 1)))))
        (if
          (= (mod y 2) 0)
          (assign ((x (+ x 2))))
          (assign ((x (- x 2)))))
        (if
          (= (mod y 2) 0)
          (assign ((x (+ x 2))))
          (assign ((x (+ x 2)))))
        (if
          (= (mod y 2) 0)
          (assign ((x (+ x 2))))
          (assign ((x (- x 2)))))
        (if
          (= (mod y 2) 0)
          (assign ((x (+ x 2))))
          (assign ((x (+ x 2)))))
        (if
          (= (mod y 2) 0)
          (assign ((x (+ x 2))))
          (assign ((x (- x 4)))))
        (if
          (= (mod y 2) 0)
          (assign ((x (+ x 2))))
          (assign ((x (+ x 4)))))
        (if
          (= (mod y 2) 0)
          (assign ((x (+ x 2))))
          (assign ((x (+ x 2)))))
        (if
          (= (mod y 2) 0)
          (assign ((x (+ x 2))))
          (assign ((x (- x 4)))))
        (if
          (= (mod y 2) 0)
          (assign ((x (+ x 2))))
          (assign ((x (- x 4)))))))
    (assert
      (= (mod x 2) (mod y 2)))))
