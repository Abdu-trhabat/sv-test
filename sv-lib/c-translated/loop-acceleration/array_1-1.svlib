(set-logic QF_ALIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((A (Array Int Int)) (i Int))
  (!
    (sequence
      (assign (i 0))
      (!
        (while
          (< i 1024)
          (sequence (assign (A (store A i i))) (assign (i (+ i 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1))
    :tag
    main))

(annotate-tag main-check-1 :check-true (not (= (select A 1023) 1023)))

(verify-call main ())

(get-witness)
