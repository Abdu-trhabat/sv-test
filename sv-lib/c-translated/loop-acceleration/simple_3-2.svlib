(set-logic QF_NIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((x Int) (N Int))
  (!
    (sequence
      (assign (x 0))
      (! (while (< x N) (assign (x (+ x 2)))) :tag main-while-1)
      (! (sequence) :tag main-check-1))
    :tag
    main))

(annotate-tag main-check-1 :check-true (not (not (= (mod x 2) 0))))

(verify-call main ())

(get-witness)
