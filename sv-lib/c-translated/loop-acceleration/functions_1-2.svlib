(set-logic QF_NIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
  f
  ((z Int))
  ((result Int))
  ()
  (!
    (sequence (assign (result (+ z 2))) (return))
    :tag
    f))

(define-proc
  main
  ()
  ((result Int))
  ((x Int) (f$1 Int))
  (!
    (sequence
      (assign (x 0))
      (!
        (while
          (< x 268435455)
          (sequence (call f (x) (f$1)) (assign (x f$1))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1))
    :tag
    main))

(annotate-tag main-check-1 :check-true (not (= (mod x 2) 0)))

(verify-call main ())

(get-witness)
