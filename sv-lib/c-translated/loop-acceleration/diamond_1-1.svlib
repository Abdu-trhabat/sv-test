(set-logic QF_NIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (!
    (sequence
      (assign (x 0))
      (!
        (while
          (< x 99)
          (if (= (mod y 2) 0) (assign (x (+ x 2))) (assign (x (+ x 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= (mod x 2) (mod y 2)))

(verify-call main ())

(get-witness)
