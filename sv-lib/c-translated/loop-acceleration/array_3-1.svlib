(set-logic QF_ALIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((A (Array Int Int)) (i Int) (nondet_int$1 Int))
  (!
    (sequence
      (assign (i 0))
      (!
        (while
          (< i 1024)
          (sequence (assign (A (store A i nondet_int$1))) (assign (i (+ i 1)))))
        :tag
        main-while-1)
      (assign (i 0))
      (!
        (while
          (not (= (select A i) 0))
          (sequence (if (<= (- 1024 1) i) (break)) (assign (i (+ i 1)))))
        :tag
        main-while-2)
      (! (sequence) :tag main-check-1))
    :tag
    main))

(annotate-tag main-check-1 :check-true (<= i 1024))

(verify-call main ())

(get-witness)
