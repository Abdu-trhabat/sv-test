(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (sequence
    (assign ((x 0)))
    (assign ((y 0)))
    (while
      (< x 268435455)
      (sequence
        (assign ((y 0)))
        (while
          (< y 10)
          (assign ((y (+ y 1)))))
        (assign ((x (+ x 1))))))
    (assert
      (not
        (not (= (mod x 2) 0))))))
