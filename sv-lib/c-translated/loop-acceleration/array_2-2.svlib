(set-logic ALL)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((A (Array Int Int))
    (B (Array Int Int))
    (i Int)
    (tmp Int)
    (nondet_int$1 Int)
    (nondet_int$2 Int))
  (!
    (sequence
      (assign (i 0))
      (!
        (while
          (< i 2048)
          (sequence
            (assign (A (store A i nondet_int$1)))
            (assign (B (store B i nondet_int$2)))
            (assign (i (+ i 1)))))
        :tag
        main-while-1)
      (assign (i 0))
      (!
        (while
          (< i 2048)
          (sequence
            (assign (tmp (select A i)))
            (assign (B (store B i tmp)))
            (assign (i (+ i 1)))))
        :tag
        main-while-2)
      (! (sequence) :tag main-check-1))
    :tag
    main))

(annotate-tag
  main-check-1
  :check-true
  (= (select A (div 2048 2)) (select B (div 2048 2))))

(verify-call main ())

(get-witness)
