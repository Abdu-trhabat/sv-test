(set-logic QF_NIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (!
    (sequence
      (assign (x 0))
      (assign (y 1))
      (!
        (while
          (< x 6)
          (sequence (assign (x (+ x 1))) (assign (y (* y 2)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1))
    :tag
    main))

(annotate-tag main-check-1 :check-true (not (= (mod y 3) 0)))

(verify-call main ())

(get-witness)
