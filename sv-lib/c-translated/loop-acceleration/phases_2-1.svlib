(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (sequence
    (assign ((x 1)))
    (if
      (not (< 0 y))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< x y)
      (if
        (< x (div y x))
        (assign ((x (* x x))))
        (assign ((x (+ x 1))))))
    (assert (not (= x y)))))
