(set-logic QF_NIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (!
    (sequence
      (assign (x 1))
      (if (not (< 0 y)) (sequence (assign (result 0)) (return)))
      (!
        (while
          (< x y)
          (if (< x (div y x)) (assign (x (* x x))) (assign (x (+ x 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= x y))

(verify-call main ())

(get-witness)
