(define-proc
  main
  ()
  ((result Int))
  ((a Int) (b Int))
  (sequence
    (assign ((a 6)))
    (assign ((b 6)))
    (assign ((a 0)))
    (while
      (< a 6)
      (sequence
        (assign ((b 0)))
        (while
          (< b 6)
          (assign ((b (+ b 1)))))
        (assign ((a (+ a 1))))))
    (if
      (not
        (and (= a 6) (= b 6)))
      (assert false))
    (assign ((result 1)))
    (return)))
