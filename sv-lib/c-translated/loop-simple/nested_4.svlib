(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((a Int) (b Int) (c Int) (d Int))
  (!
    (sequence
      (assign (a 6))
      (assign (b 6))
      (assign (c 6))
      (assign (d 6))
      (assign (a 0))
      (!
        (while
          (< a 6)
          (sequence
            (assign (b 0))
            (!
              (while
                (< b 6)
                (sequence
                  (assign (c 0))
                  (!
                    (while
                      (< c 6)
                      (sequence
                        (assign (d 0))
                        (! (while (< d 6) (assign (d (+ d 1)))) :tag main-while-4)
                        (assign (c (+ c 1)))))
                    :tag
                    main-while-3)
                  (assign (b (+ b 1)))))
              :tag
              main-while-2)
            (assign (a (+ a 1)))))
        :tag
        main-while-1)
      (if
        (not (and (= a 6) (= b 6) (= c 6) (= d 6)))
        (! (sequence) :tag main-check-1))
      (assign (result 1))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true false)

(verify-call main ())

(get-witness)
