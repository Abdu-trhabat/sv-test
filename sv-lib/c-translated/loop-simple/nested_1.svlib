(set-logic QF_LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((a Int))
  (!
    (sequence
      (assign (a 6))
      (assign (a 0))
      (! (while (< a 6) (assign (a (+ a 1)))) :tag main-while-1)
      (if (not (= a 6)) (! (sequence) :tag main-check-1))
      (assign (result 1))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true false)

(verify-call main ())

(get-witness)
