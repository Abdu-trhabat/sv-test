(set-logic QF_LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(declare-var SIZE Int)
(declare-var last Int)

(define-proc
  main
  ()
  ((result Int))
  ((a Int) (b Int) (c Int) (st Int) (d Int))
  (!
    (sequence
      (assign (last 0))
      (assign (SIZE 200000))
      (havoc last)
      (assume (< 0 last))
      (assign (a 0))
      (assign (b 0))
      (assign (c 0))
      (assign (st 0))
      (assign (d 0))
      (!
        (while
          (not (= 1 0))
          (sequence
            (assign (st 1))
            (assign (c 0))
            (!
              (while
                (< c SIZE)
                (sequence (if (<= last c) (assign (st 0))) (assign (c (+ c 1)))))
              :tag
              main-while-2)
            (if
              (and (= st 0) (= c (+ last 1)))
              (sequence (assign (a (+ a 3))) (assign (b (+ b 3))))
              (sequence (assign (a (+ a 2))) (assign (b (+ b 2)))))
            (if
              (and (= c last) (= st 0))
              (assign (a (+ a 1)))
              (if (and (= st 1) (< last SIZE)) (assign (d (+ d 1)))))
            (if
              (= d SIZE)
              (sequence (assign (a 0)) (assign (b 1))))
            (! (sequence) :tag main-check-1)))
        :tag
        main-while-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (and (= a b) (= c SIZE)))

(verify-call main ())

(get-witness)
