(set-logic QF_NIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((n Int) (i Int) (k Int))
  (!
    (sequence
      (assign (SIZE 20000001))
      (havoc n)
      (if (not (<= n SIZE)) (sequence (assign (result 0)) (return)))
      (assign (k n))
      (assign (i 0))
      (!
        (while
          (< i n)
          (sequence (assign (k (- k 1))) (assign (i (+ i 3)))))
        :tag
        main-while-1)
      (assign (j 0))
      (!
        (while
          (< j (div n 3))
          (sequence
            (! (sequence) :tag main-check-1)
            (assign (k (- k 1)))
            (assign (j (+ j 1)))))
        :tag
        main-while-2)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (< 0 k))

(verify-call main ())

(get-witness)
