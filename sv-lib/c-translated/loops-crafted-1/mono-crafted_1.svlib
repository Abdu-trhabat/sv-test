(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int) (z Int))
  (!
    (sequence
      (assign (x 0))
      (assign (y 50000))
      (assign (z 0))
      (assign (x 0))
      (!
        (while
          (< x 1000000)
          (if
            (< x 50000)
            (assign (x (+ x 1)))
            (sequence (assign (x (+ x 1))) (assign (y (+ y 1))))))
        :tag
        main-while-1)
      (!
        (while
          (< z y)
          (sequence (assign (y (- y 1))) (assign (x (- x 1)))))
        :tag
        main-while-2)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= x z))

(verify-call main ())

(get-witness)
