(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int) (z Int))
  (sequence
    (assign ((x 0)))
    (assign ((y 10000000)))
    (assign ((z 5000000)))
    (while
      (< x y)
      (sequence
        (if
          (<= 5000000 x)
          (assign ((z (+ z 1)))))
        (assign ((x (+ x 1))))))
    (assert (= z x))
    (assign ((result 0)))
    (return)))
