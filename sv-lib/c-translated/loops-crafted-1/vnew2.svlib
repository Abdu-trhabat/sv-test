(define-proc
  main
  ()
  ((result Int))
  ((n Int) (i Int) (k Int) (j Int))
  (sequence
    (assign ((SIZE 20000001)))
    (havoc (n))
    (if
      (not (<= n SIZE))
      (sequence
        (assign ((result 0)))
        (return)))
    (assign ((k 0)))
    (assign ((j k)))
    (assign ((i j)))
    (while
      (< i n)
      (sequence
        (assign ((i (+ i 3))))
        (assign ((j (+ j 3))))
        (assign ((k (+ k 3))))))
    (if
      (< 0 n)
      (assert
        (and
          (= i j)
          (= j k)
          (not
            (= (mod i (+ SIZE 2)) 0)))))
    (assign ((result 0)))
    (return)))
