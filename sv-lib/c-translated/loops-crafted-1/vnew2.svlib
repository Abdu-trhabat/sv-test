(set-logic QF_NIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(declare-var SIZE Int)

(define-proc
  main
  ()
  ((result Int))
  ((n Int) (i Int) (k Int) (j Int))
  (!
    (sequence
      (assign (SIZE 20000001))
      (havoc n)
      (if (not (<= n SIZE)) (sequence (assign (result 0)) (return)))
      (assign (k 0))
      (assign (j k))
      (assign (i j))
      (!
        (while
          (< i n)
          (sequence (assign (i (+ i 3))) (assign (j (+ j 3))) (assign (k (+ k 3)))))
        :tag
        main-while-1)
      (if (< 0 n) (! (sequence) :tag main-check-1))
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag
  main-check-1
  :check-true
  (and (= i j) (= j k) (not (= (mod i (+ SIZE 2)) 0))))

(verify-call main ())

(get-witness)
