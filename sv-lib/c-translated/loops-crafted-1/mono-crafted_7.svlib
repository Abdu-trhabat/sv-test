(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int) (z Int))
  (sequence
    (assign ((x 0)))
    (assign ((y 50000)))
    (assign ((z 0)))
    (assign ((x 0)))
    (while
      (< x 1000000)
      (if
        (< x 50000)
        (assign ((x (+ x 1))))
        (sequence
          (assign ((x (+ x 1))))
          (assign ((y (+ y 1)))))))
    (while
      (< 0 y)
      (sequence
        (assign ((y (- y 2))))
        (assign ((x (- x 2))))))
    (assert (= z x))
    (assign ((result 0)))
    (return)))
