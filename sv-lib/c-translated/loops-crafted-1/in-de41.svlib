(define-proc
  main
  ()
  ((result Int))
  ((n Int) (x Int) (y Int) (z Int))
  (sequence
    (assign ((x n)))
    (assign ((y 0)))
    (while
      (< 0 x)
      (sequence
        (assign ((x (- x 1))))
        (assign ((y (+ y 1))))))
    (assign ((z y)))
    (while
      (< 0 z)
      (sequence
        (assign ((x (+ x 1))))
        (assign ((z (- z 1))))))
    (while
      (< 0 y)
      (sequence
        (assign ((y (- y 1))))
        (assign ((z (+ z 1))))))
    (while
      (< 0 x)
      (sequence
        (assign ((x (- x 1))))
        (assign ((y (+ y 1))))))
    (assert (= y n))
    (assign ((result 0)))
    (return)))
