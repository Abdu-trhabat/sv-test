(set-logic QF_NIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int) (z Int))
  (!
    (sequence
      (assign (x 0))
      (assign (y 0))
      (assign (z 0))
      (!
        (while
          (< x 268435455)
          (sequence
            (assign (y 0))
            (!
              (while
                (< y 268435455)
                (sequence
                  (assign (z 0))
                  (!
                    (while (< z 268435455) (assign (z (+ z 1))))
                    :tag
                    main-while-3)
                  (! (sequence) :tag main-check-1)
                  (assign (y (+ y 1)))))
              :tag
              main-while-2)
            (! (sequence) :tag main-check-2)
            (assign (x (+ x 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-3)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (not (= (mod z 4) 0)))

(annotate-tag main-check-2 :check-true (not (= (mod y 2) 0)))

(annotate-tag main-check-3 :check-true (not (= (mod x 2) 0)))

(verify-call main ())

(get-witness)
