(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (sequence
    (assign ((x 0)))
    (assign ((y 0)))
    (while
      (< x 1000000)
      (sequence
        (if
          (< x 500000)
          (assign ((y (+ y 1))))
          (assign ((y (- y 1)))))
        (assign ((x (+ x 1))))))
    (assert (not (= y 0)))))
