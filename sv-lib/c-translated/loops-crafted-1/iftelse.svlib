(set-logic QF_NIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(declare-var SIZE Int)

(define-proc
  main
  ()
  ((result Int))
  ((n Int) (i Int) (k Int) (j Int))
  (!
    (sequence
      (assign (SIZE 20000001))
      (havoc n)
      (if (not (<= n SIZE)) (sequence (assign (result 0)) (return)))
      (assign (k 0))
      (assign (j k))
      (assign (i j))
      (!
        (while
          (< i n)
          (sequence
            (assign (i (+ i 3)))
            (if (not (= (mod i 2) 0)) (assign (j (+ j 3))) (assign (k (+ k 3))))
            (if (< 0 n) (! (sequence) :tag main-check-1))))
        :tag
        main-while-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (<= (div i 2) j))

(verify-call main ())

(get-witness)
