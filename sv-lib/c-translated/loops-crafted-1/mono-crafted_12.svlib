(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int) (z Int))
  (sequence
    (assign ((x 0)))
    (assign ((y 10000000)))
    (assign ((z 0)))
    (while
      (< x y)
      (sequence
        (if
          (<= 5000000 x)
          (assign ((z (+ z 2)))))
        (assign ((x (+ x 1))))))
    (assert
      (not
        (not (= (mod z 2) 0))))
    (assign ((result 0)))
    (return)))
