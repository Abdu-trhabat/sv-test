(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(declare-var trueVar Int)
(declare-var falseVar Int)

(define-proc
  correct_version
  ((w Int))
  ((result Int))
  ((is_divisible Int) (i Int))
  (!
    (sequence
      (assign (is_divisible trueVar))
      (if
        (< w 4)
        (assign (is_divisible falseVar))
        (sequence
          (assign (i 0))
          (! (while (< i w) (assign (i (+ i 2)))) :tag correct_version-while-1)
          (if (not (= i w)) (assign (is_divisible falseVar)))))
      (assign (result is_divisible))
      (return))
    :tag
    correct_version))

(define-proc
  student_version
  ((w Int))
  ((result Int))
  ((is_divisible Int) (i Int))
  (!
    (sequence
      (assign (is_divisible trueVar))
      (if
        (< w 4)
        (assign (is_divisible falseVar))
        (sequence
          (assign (i 0))
          (! (while (< i w) (assign (i (+ i 2)))) :tag student_version-while-2)
          (if (not (= i w)) (assign (is_divisible falseVar)))))
      (assign (result is_divisible))
      (return))
    :tag
    student_version))

(define-proc
  main
  ()
  ((result Int))
  ((w Int)
    (is_divisible1 Int)
    (is_divisible2 Int)
    (correct_version$1 Int)
    (student_version$2 Int))
  (!
    (sequence
      (assign (trueVar 1))
      (assign (falseVar 0))
      (assign (is_divisible1 trueVar))
      (assign (is_divisible2 trueVar))
      (if
        (and (< 0 w) (< w 10000000))
        (sequence
          (call correct_version (w) (correct_version$1))
          (assign (is_divisible1 correct_version$1))
          (call student_version (w) (student_version$2))
          (assign (is_divisible2 student_version$2))
          (! (sequence) :tag main-check-1)))
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= is_divisible1 is_divisible2))

(verify-call main ())

(get-witness)
