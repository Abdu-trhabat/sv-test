(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int) (z Int))
  (!
    (sequence
      (assign (x 0))
      (assign (y 10000000))
      (assign (z 5000000))
      (!
        (while
          (< x y)
          (sequence
            (if (<= 5000000 x) (assign (z (- z 1))))
            (assign (x (+ x 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= z 0))

(verify-call main ())

(get-witness)
