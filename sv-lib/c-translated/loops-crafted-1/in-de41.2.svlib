(set-logic QF_LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((n Int) (x Int) (y Int) (z Int))
  (!
    (sequence
      (assume (>= n 0))
      (assign (x n))
      (assign (y 0))
      (!
        (while
          (< 0 x)
          (sequence (assign (x (- x 1))) (assign (y (+ y 1)))))
        :tag
        main-while-1)
      (assign (z y))
      (!
        (while
          (< 0 z)
          (sequence (assign (x (+ x 1))) (assign (z (- z 1)))))
        :tag
        main-while-2)
      (!
        (while
          (< 0 y)
          (sequence (assign (y (- y 1))) (assign (z (+ z 1)))))
        :tag
        main-while-3)
      (!
        (while
          (< 0 x)
          (sequence (assign (x (- x 1))) (assign (y (+ y 1)))))
        :tag
        main-while-4)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= y n))

(verify-call main ())

(get-witness)
