(set-logic QF_NIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int) (z Int))
  (!
    (sequence
      (assign (x 0))
      (assign (y 500000))
      (assign (z 0))
      (assign (x 0))
      (!
        (while
          (< x 1000000)
          (if
            (< x 500000)
            (assign (x (+ x 1)))
            (sequence (assign (x (+ x 1))) (assign (y (+ y 1))))))
        :tag
        main-while-1)
      (!
        (while
          (< 0 y)
          (sequence (assign (x (- x 1))) (assign (z (+ z 1))) (assign (y (- y 2)))))
        :tag
        main-while-2)
      (! (sequence) :tag main-check-1)
      (! (sequence) :tag main-check-2)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= (mod z 2) 0))

(annotate-tag main-check-2 :check-true (= (mod x 2) 0))

(verify-call main ())

(get-witness)
