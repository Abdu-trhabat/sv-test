(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (sequence
    (assign ((x 0)))
    (assign ((y 500000)))
    (while
      (< x 1000000)
      (if
        (< x 500000)
        (assign ((x (+ x 1))))
        (sequence
          (assign ((x (+ x 1))))
          (assign ((y (+ y 1)))))))
    (assert (= y x))
    (assign ((result 0)))
    (return)))
