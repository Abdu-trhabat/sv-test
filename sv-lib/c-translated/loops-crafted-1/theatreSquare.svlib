(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(declare-var x Int)
(declare-var y Int)

(define-proc
  correct_version
  ((n Int) (m Int) (a Int))
  ((result Int))
  ((i Int) (j Int) (b Int) (l Int))
  (!
    (sequence
      (assign (i 0))
      (assign (j 0))
      (assign (b 0))
      (assign (l 0))
      (!
        (while
          (< b n)
          (sequence (assign (b (+ b a))) (assign (i (+ i 1)))))
        :tag
        correct_version-while-1)
      (!
        (while
          (< l m)
          (sequence (assign (l (+ l a))) (assign (j (+ j 1)))))
        :tag
        correct_version-while-2)
      (assign (x 0))
      (assign (y 0))
      (!
        (while
          (< x i)
          (sequence (assign (y (+ y j))) (assign (x (+ x 1)))))
        :tag
        correct_version-while-3)
      (assign (result y))
      (return))
    :tag
    correct_version))

(define-proc
  student_version
  ((n Int) (m Int) (a Int))
  ((result Int))
  ((i Int) (j Int) (b Int) (l Int))
  (!
    (sequence
      (assign (i 0))
      (assign (j 0))
      (assign (b 0))
      (assign (l 0))
      (!
        (while
          (< b n)
          (sequence (assign (b (+ b a))) (assign (i (+ i 1)))))
        :tag
        student_version-while-4)
      (!
        (while
          (< l m)
          (sequence (assign (l (+ l a))) (assign (j (+ j 1)))))
        :tag
        student_version-while-5)
      (assign (x 0))
      (assign (y 0))
      (!
        (while
          (< x i)
          (sequence (assign (y (+ y j))) (assign (x (+ x 1)))))
        :tag
        student_version-while-6)
      (assign (result y))
      (return))
    :tag
    student_version))

(define-proc
  main
  ()
  ((result Int))
  ((a Int)
    (n Int)
    (m Int)
    (n_stones1 Int)
    (n_stones2 Int)
    (correct_version$1 Int)
    (student_version$2 Int))
  (!
    (sequence
      (assign (n_stones1 n_stones2))
      (if
        (and (<= 1 n) (<= 1 m) (<= 1 a) (<= n 109) (<= m 109) (<= a 109))
        (sequence
          (call correct_version (n m a) (correct_version$1))
          (assign (n_stones1 correct_version$1))
          (call student_version (n m a) (student_version$2))
          (assign (n_stones2 student_version$2))))
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= n_stones1 n_stones2))

(verify-call main ())

(get-witness)
