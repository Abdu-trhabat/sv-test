(define-proc
  main
  ()
  ((result Int))
  ((n Int) (i Int) (j Int) (l Int))
  (sequence
    (assign ((SIZE 20000001)))
    (assign ((l 0)))
    (havoc (n))
    (if
      (not (<= n SIZE))
      (sequence
        (assign ((result 0)))
        (return)))
    (assign ((i 0)))
    (assign ((j 0)))
    (assign ((l 0)))
    (while
      (< l n)
      (sequence
        (if
          (not
            (not (= (mod l 2) 0)))
          (assign ((i (+ i 1))))
          (assign ((j (+ j 1)))))
        (assign ((l (+ l 1))))))
    (assert (= (+ i j) l))
    (assign ((result 0)))
    (return)))
