(set-logic QF_NIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(declare-var SIZE Int)

(define-proc
  main
  ()
  ((result Int))
  ((n Int) (i Int) (j Int) (l Int))
  (!
    (sequence
      (assign (SIZE 20000001))
      (assign (l 0))
      (havoc n)
      (if (not (<= n SIZE)) (sequence (assign (result 0)) (return)))
      (assign (i 0))
      (assign (j 0))
      (assign (l 0))
      (!
        (while
          (< l n)
          (sequence
            (if (not (not (= (mod l 2) 0))) (assign (i (+ i 1))) (assign (j (+ j 1))))
            (assign (l (+ l 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= (+ i j) l))

(verify-call main ())

(get-witness)
