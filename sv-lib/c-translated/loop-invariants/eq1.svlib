(set-logic QF_LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((w Int) (x Int) (y Int) (z Int) (nondet_uint$1 Int) (nondet_uint$2 Int))
  (!
    (sequence
      (assign (x w))
      (assign (z y))
      (!
        (while
          true
          (sequence
            (if (not (not (= nondet_uint$1 0))) (break))
            (if
              (not (= nondet_uint$2 0))
              (sequence (assign (w (+ w 1))) (assign (x (+ x 1))))
              (sequence (assign (y (- y 1))) (assign (z (- z 1)))))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (and (= w x) (= y z)))

(verify-call main ())

(get-witness)
