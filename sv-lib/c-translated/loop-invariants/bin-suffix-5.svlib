(set-logic QF_NIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((x Int) (nondet_int$1 Int))
  (!
    (sequence
      (assign (x 5))
      (!
        (while
          true
          (sequence
            (if (not (not (= nondet_int$1 0))) (break))
            (assign (x (+ x 8)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (and (= (mod (div x 4) 2) 1) (= (mod (div x 2) 2) 0) (= (mod x 2) 1)))

(verify-call main ())

(get-witness)
