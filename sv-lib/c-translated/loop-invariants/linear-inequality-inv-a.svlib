(define-proc
  main
  ()
  ((result Int))
  ((n Int) (v Int) (s Int) (i Int))
  (sequence
    (if
      (= n 0)
      (sequence
        (assign ((result 0)))
        (return)))
    (assign ((v 0)))
    (assign ((s 0)))
    (assign ((i 0)))
    (while
      (< i n)
      (sequence
        (havoc (v))
        (assign ((s (+ s v))))
        (assign ((i (+ i 1))))))
    (if
      (< s v)
      (sequence
        (assert false)
        (assign ((result 1)))
        (return)))
    (if
      (< 65025 s)
      (sequence
        (assert false)
        (assign ((result 1)))
        (return)))
    (assign ((result 0)))
    (return)))
