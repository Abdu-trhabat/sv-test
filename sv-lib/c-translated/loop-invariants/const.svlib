(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((s Int) (nondet_uint$1 Int) (nondet_uint$2 Int))
  (!
    (sequence
      (assign (s 0))
      (!
        (while
          true
          (sequence
            (if (not (not (= nondet_uint$1 0))) (break))
            (if (not (= s 0)) (assign (s (+ s 1))))
            (if (not (= nondet_uint$2 0)) (! (sequence) :tag main-check-1))))
        :tag
        main-while-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= s 0))

(verify-call main ())

(get-witness)
