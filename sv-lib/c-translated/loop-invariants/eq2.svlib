(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((w Int) (x Int) (y Int) (z Int) (nondet_uint$1 Int))
  (!
    (sequence
      (assign (x w))
      (assign (y (+ w 1)))
      (assign (z (+ x 1)))
      (!
        (while
          true
          (sequence
            (if (not (not (= nondet_uint$1 0))) (break))
            (assign (y (+ y 1)))
            (assign (z (+ z 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= y z))

(verify-call main ())

(get-witness)
