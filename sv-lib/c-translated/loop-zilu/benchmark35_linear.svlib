(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((x Int))
  (!
    (sequence
      (if (not (<= 0 x)) (sequence (assign (result 0)) (return)))
      (!
        (while (and (<= 0 x) (< x 10)) (assign (x (+ x 1))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (<= 10 x))

(verify-call main ())

(get-witness)
