(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((x Int) (nondet_bool$1 Int))
  (!
    (sequence
      (if (not (and (<= 0 x) (<= x 50))) (sequence (assign (result 0)) (return)))
      (!
        (while
          true
          (sequence
            (if (not (not (= nondet_bool$1 0))) (break))
            (if (< 50 x) (assign (x (+ x 1))))
            (if (= x 0) (assign (x (+ x 1))) (assign (x (- x 1))))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (and (<= 0 x) (<= x 50)))

(verify-call main ())

(get-witness)
