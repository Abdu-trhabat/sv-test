(set-logic QF_LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int) (t Int) (nondet_bool$1 Int))
  (!
    (sequence
      (if (not (and (not (= x y)) (= y t))) (sequence (assign (result 0)) (return)))
      (!
        (while
          true
          (sequence
            (if (not (not (= nondet_bool$1 0))) (break))
            (if (< 0 x) (assign (y (+ y x))))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (<= t y))

(verify-call main ())

(get-witness)
