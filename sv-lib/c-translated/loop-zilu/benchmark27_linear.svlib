(define-proc
  main
  ()
  ((result Int))
  ((i Int) (j Int) (k Int))
  (sequence
    (if
      (not
        (and (< i j) (< (- i j) k)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< i j)
      (sequence
        (assign ((k (+ k 1))))
        (assign ((i (+ i 1))))))
    (assert (< 0 k))
    (assign ((result 0)))
    (return)))
