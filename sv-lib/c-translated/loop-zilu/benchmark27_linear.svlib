(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((i Int) (j Int) (k Int))
  (!
    (sequence
      (if (not (and (< i j) (< (- i j) k))) (sequence (assign (result 0)) (return)))
      (!
        (while
          (< i j)
          (sequence (assign (k (+ k 1))) (assign (i (+ i 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (< 0 k))

(verify-call main ())

(get-witness)
