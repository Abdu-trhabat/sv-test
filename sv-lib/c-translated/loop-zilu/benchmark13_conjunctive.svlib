(define-proc
  main
  ()
  ((result Int))
  ((i Int) (j Int) (k Int))
  (sequence
    (if
      (not
        (and (= i 0) (= j 0)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (<= i k)
      (sequence
        (assign ((i (+ i 1))))
        (assign ((j (+ j 1))))))
    (assert (= j i))
    (assign ((result 0)))
    (return)))
