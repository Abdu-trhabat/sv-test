(define-proc
  main
  ()
  ((result Int))
  ((i Int) (k Int) (n Int))
  (sequence
    (if
      (not
        (and (= i 0) (= k 0) (< 0 n)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< i n)
      (sequence
        (assign ((i (+ i 1))))
        (assign ((k (+ k 1))))))
    (assert
      (and (= i k) (= k n)))
    (assign ((result 0)))
    (return)))
