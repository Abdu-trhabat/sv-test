(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((i Int) (k Int) (nondet_bool$1 Int))
  (!
    (sequence
      (if (not (and (<= 0 k) (<= k 1) (= i 1))) (sequence (assign (result 0)) (return)))
      (!
        (while
          true
          (sequence
            (if (not (not (= nondet_bool$1 0))) (break))
            (assign (i (+ i 1)))
            (assign (k (- k 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag
  main-check-1
  :check-true
  (and (<= 1 (+ i k)) (<= (+ i k) 2) (<= 1 i)))

(verify-call main ())

(get-witness)
