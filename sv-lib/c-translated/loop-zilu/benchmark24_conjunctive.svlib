(define-proc
  main
  ()
  ((result Int))
  ((i Int) (k Int) (n Int))
  (sequence
    (if
      (not
        (and (= i 0) (= k n) (<= 0 n)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< i n)
      (sequence
        (assign ((k (- k 1))))
        (assign ((i (+ i 2))))))
    (assert (<= (- n 1) (* 2 k)))
    (assign ((result 0)))
    (return)))
