(define-proc
  main
  ()
  ((result Int))
  ((i Int) (n Int) (sum Int))
  (sequence
    (if
      (not
        (and (= i 0) (<= 0 n) (<= n 100) (= sum 0)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< i n)
      (sequence
        (assign ((sum (+ sum i))))
        (assign ((i (+ i 1))))))
    (assert (<= 0 sum))
    (assign ((result 0)))
    (return)))
