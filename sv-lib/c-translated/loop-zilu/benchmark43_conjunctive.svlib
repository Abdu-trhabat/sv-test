(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (sequence
    (if
      (not
        (and (< x 100) (< y 100)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (and (< x 100) (< y 100))
      (sequence
        (assign ((x (+ x 1))))
        (assign ((y (+ y 1))))))
    (assert
      (or (= x 100) (= y 100)))
    (assign ((result 0)))
    (return)))
