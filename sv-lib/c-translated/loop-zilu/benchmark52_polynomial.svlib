(define-proc
  main
  ()
  ((result Int))
  ((i Int))
  (sequence
    (if
      (not
        (and (< i 10) (< (- 10) i)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< (* i i) 100)
      (assign ((i (+ i 1)))))
    (assert (= i 10))
    (assign ((result 0)))
    (return)))
