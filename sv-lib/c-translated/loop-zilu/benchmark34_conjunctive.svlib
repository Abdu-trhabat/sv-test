(define-proc
  main
  ()
  ((result Int))
  ((j Int) (k Int) (n Int))
  (sequence
    (if
      (not
        (and (= j 0) (= k n) (< 0 n)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (and (< j n) (< 0 n))
      (sequence
        (assign ((j (+ j 1))))
        (assign ((k (- k 1))))))
    (assert (= k 0))
    (assign ((result 0)))
    (return)))
