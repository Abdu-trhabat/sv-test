(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((i Int) (c Int))
  (!
    (sequence
      (if (not (and (= c 0) (= i 0))) (sequence (assign (result 0)) (return)))
      (!
        (while
          (< i 100)
          (sequence (assign (c (+ c i))) (assign (i (+ i 1))) (if (<= i 0) (break))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (<= 0 c))

(verify-call main ())

(get-witness)
