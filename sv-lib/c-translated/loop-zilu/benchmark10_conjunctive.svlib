(define-proc
  main
  ()
  ((result Int))
  ((i Int) (c Int))
  (sequence
    (if
      (not
        (and (= c 0) (= i 0)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< i 100)
      (sequence
        (assign ((c (+ c i))))
        (assign ((i (+ i 1))))
        (if (<= i 0) (break))))
    (assert (<= 0 c))
    (assign ((result 0)))
    (return)))
