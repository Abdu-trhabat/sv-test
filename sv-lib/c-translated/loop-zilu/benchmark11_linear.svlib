(set-logic QF_LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((x Int) (n Int))
  (!
    (sequence
      (if (not (and (= x 0) (< 0 n))) (sequence (assign (result 0)) (return)))
      (! (while (< x n) (assign (x (+ x 1)))) :tag main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= x n))

(verify-call main ())

(get-witness)
