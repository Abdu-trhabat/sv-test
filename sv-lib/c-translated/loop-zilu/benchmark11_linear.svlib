(define-proc
  main
  ()
  ((result Int))
  ((x Int) (n Int))
  (sequence
    (if
      (not
        (and (= x 0) (< 0 n)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< x n)
      (assign ((x (+ x 1)))))
    (assert (= x n))
    (assign ((result 0)))
    (return)))
