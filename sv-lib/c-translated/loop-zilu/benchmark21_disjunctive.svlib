(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (sequence
    (if
      (not (or (< 0 y) (< 0 x)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (not (= 1 0))
      (sequence
        (if (< (- 2) (+ x y)) (break))
        (if
          (< 0 x)
          (assign ((x (+ x 1))))
          (assign ((y (+ y 1)))))))
    (assert (or (< 0 x) (< 0 y)))
    (assign ((result 0)))
    (return)))
