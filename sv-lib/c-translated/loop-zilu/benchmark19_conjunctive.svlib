(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((j Int) (k Int) (n Int))
  (!
    (sequence
      (if (not (and (= j n) (= k n) (< 0 n))) (sequence (assign (result 0)) (return)))
      (!
        (while
          (and (< 0 j) (< 0 n))
          (sequence (assign (j (- j 1))) (assign (k (- k 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= k 0))

(verify-call main ())

(get-witness)
