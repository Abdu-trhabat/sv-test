(define-proc
  main
  ()
  ((result Int))
  ((i Int))
  (sequence
    (if
      (not
        (and (<= 0 i) (<= i 200)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< 0 i)
      (assign ((i (- i 1)))))
    (assert (<= 0 i))
    (assign ((result 0)))
    (return)))
