(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (sequence
    (if
      (not (< x y))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< x y)
      (sequence
        (if
          (and (< x 0) (< y 0))
          (sequence
            (assign ((x (+ x 7))))
            (assign ((y (- y 10))))))
        (if
          (and (< x 0) (<= 0 y))
          (sequence
            (assign ((x (+ x 7))))
            (assign ((y (+ y 3)))))
          (sequence
            (assign ((x (+ x 10))))
            (assign ((y (+ y 3))))))))
    (assert
      (and (<= y x) (<= x (+ y 16))))
    (assign ((result 0)))
    (return)))
