(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (sequence
    (if
      (not
        (and (= x y) (<= 0 y)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (not (= x 0))
      (sequence
        (assign ((x (- x 1))))
        (assign ((y (- y 1))))
        (if (or (< x 0) (< y 0)) (break))))
    (assert (= y 0))
    (assign ((result 0)))
    (return)))
