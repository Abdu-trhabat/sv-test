(set-logic QF_LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((i Int) (j Int))
  (!
    (sequence
      (if (not (and (= i 0) (= j 0))) (sequence (assign (result 0)) (return)))
      (!
        (while
          (< i 100)
          (sequence (assign (j (+ j 2))) (assign (i (+ i 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= j 200))

(verify-call main ())

(get-witness)
