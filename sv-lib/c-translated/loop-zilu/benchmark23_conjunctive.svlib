(define-proc
  main
  ()
  ((result Int))
  ((i Int) (j Int))
  (sequence
    (if
      (not
        (and (= i 0) (= j 0)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< i 100)
      (sequence
        (assign ((j (+ j 2))))
        (assign ((i (+ i 1))))))
    (assert (= j 200))
    (assign ((result 0)))
    (return)))
