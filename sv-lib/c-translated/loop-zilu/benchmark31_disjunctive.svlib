(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (sequence
    (if
      (not (< x 0))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (not (= 1 0))
      (if
        (<= 0 x)
        (break)
        (sequence
          (assign ((x (+ x y))))
          (assign ((y (+ y 1)))))))
    (assert (<= 0 y))
    (assign ((result 0)))
    (return)))
