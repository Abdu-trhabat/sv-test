(define-proc
  main
  ()
  ((result Int))
  ((n Int) (i Int) (l Int))
  (sequence
    (assign ((i l)))
    (if
      (not (< 0 l))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< i n)
      (assign ((i (+ i 1)))))
    (assert (<= 1 l))
    (assign ((result 0)))
    (return)))
