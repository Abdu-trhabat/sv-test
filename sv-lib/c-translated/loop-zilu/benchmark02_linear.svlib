(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((n Int) (i Int) (l Int))
  (!
    (sequence
      (assign (i l))
      (if (not (< 0 l)) (sequence (assign (result 0)) (return)))
      (! (while (< i n) (assign (i (+ i 1)))) :tag main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (<= 1 l))

(verify-call main ())

(get-witness)
