(define-proc
  main
  ()
  ((result Int))
  ((i Int) (j Int) (r Int))
  (sequence
    (if
      (not (< (+ i j) r))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< 0 i)
      (sequence
        (assign ((i (- i 1))))
        (assign ((j (+ j 1))))))
    (assert (< (+ i j) r))
    (assign ((result 0)))
    (return)))
