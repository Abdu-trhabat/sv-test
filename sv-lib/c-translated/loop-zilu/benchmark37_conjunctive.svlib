(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (sequence
    (if
      (not
        (and (= x y) (<= 0 x)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< 0 x)
      (sequence
        (assign ((x (- x 1))))
        (assign ((y (- y 1))))))
    (assert (<= 0 y))
    (assign ((result 0)))
    (return)))
