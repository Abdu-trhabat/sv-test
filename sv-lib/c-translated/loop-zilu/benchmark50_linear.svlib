(define-proc
  main
  ()
  ((result Int))
  ((xa Int) (ya Int))
  (sequence
    (if
      (not (< 0 (+ xa ya)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< 0 xa)
      (sequence
        (assign ((xa (- xa 1))))
        (assign ((ya (+ ya 1))))))
    (assert (<= 0 ya))
    (assign ((result 0)))
    (return)))
