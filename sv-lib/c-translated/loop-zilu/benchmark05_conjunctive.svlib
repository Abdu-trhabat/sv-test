(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int) (n Int))
  (sequence
    (if
      (not
        (and (<= 0 x) (<= x y) (< y n)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< x n)
      (sequence
        (assign ((x (+ x 1))))
        (if
          (< y x)
          (assign ((y (+ y 1)))))))
    (assert (= y n))
    (assign ((result 0)))
    (return)))
