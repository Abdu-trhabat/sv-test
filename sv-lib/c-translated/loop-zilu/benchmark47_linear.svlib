(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (sequence
    (if
      (not (< x y))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< x y)
      (sequence
        (if
          (< x 0)
          (assign ((x (+ x 7))))
          (assign ((x (+ x 10)))))
        (if
          (< y 0)
          (assign ((y (- y 10))))
          (assign ((y (+ y 3)))))))
    (assert
      (and (<= y x) (<= x (+ y 16))))
    (assign ((result 0)))
    (return)))
