(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (!
    (sequence
      (if (not (< x y)) (sequence (assign (result 0)) (return)))
      (!
        (while
          (< x y)
          (sequence
            (if (< x 0) (assign (x (+ x 7))) (assign (x (+ x 10))))
            (if (< y 0) (assign (y (- y 10))) (assign (y (+ y 3))))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (and (<= y x) (<= x (+ y 16))))

(verify-call main ())

(get-witness)
