(define-proc
  main
  ()
  ((result Int))
  ((i Int) (j Int))
  (sequence
    (if
      (not (< (* i i) (* j j)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< i j)
      (sequence
        (assign ((j (- j i))))
        (if
          (< j i)
          (sequence
            (assign ((j (+ j i))))
            (assign ((i (- j i))))
            (assign ((j (- j i))))))))
    (assert (= j i))
    (assign ((result 0)))
    (return)))
