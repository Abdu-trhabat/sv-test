(set-logic QF_LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int) (z Int))
  (!
    (sequence
      (if
        (not
          (and (= x y) (<= 0 x) (= (+ (+ x y) z) 0)))
        (sequence (assign (result 0)) (return)))
      (!
        (while
          (< 0 x)
          (sequence
            (assign (x (- x 1)))
            (assign (y (- y 1)))
            (assign (z (+ z 1)))
            (assign (z (+ z 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (<= z 0))

(verify-call main ())

(get-witness)
