(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int) (z Int))
  (sequence
    (if
      (not
        (and (= x y) (<= 0 x) (= (+ (+ x y) z) 0)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< 0 x)
      (sequence
        (assign ((x (- x 1))))
        (assign ((y (- y 1))))
        (assign ((z (+ z 1))))
        (assign ((z (+ z 1))))))
    (assert (<= z 0))
    (assign ((result 0)))
    (return)))
