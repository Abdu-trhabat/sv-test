(define-proc
  main
  ()
  ((result Int))
  ((k Int) (j Int) (n Int))
  (sequence
    (if
      (not
        (and (<= 1 n) (<= n k) (= j 0)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (<= j (- n 1))
      (sequence
        (assign ((j (+ j 1))))
        (assign ((k (- k 1))))))
    (assert (<= 0 k))
    (assign ((result 0)))
    (return)))
