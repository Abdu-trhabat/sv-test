(define-proc
  main
  ()
  ((result Int))
  ((n Int) (sum Int) (i Int))
  (sequence
    (if
      (not
        (and (<= 0 n) (= sum 0) (= i 0)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< i n)
      (sequence
        (assign ((sum (+ sum i))))
        (assign ((i (+ i 1))))))
    (assert (<= 0 sum))
    (assign ((result 0)))
    (return)))
