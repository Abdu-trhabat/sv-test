(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (sequence
    (if
      (not (< x y))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< x y)
      (assign ((x (+ x 100)))))
    (assert
      (and (<= y x) (<= x (+ y 99))))
    (assign ((result 0)))
    (return)))
