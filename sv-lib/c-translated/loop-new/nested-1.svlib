(define-proc
  main
  ()
  ((result Int))
  ((n Int) (m Int) (k Int) (i Int) (j Int))
  (sequence
    (assign ((k 0)))
    (if
      (not
        (and (<= 10 n) (<= n 10000)))
      (sequence
        (assign ((result 0)))
        (return)))
    (if
      (not
        (and (<= 10 m) (<= m 10000)))
      (sequence
        (assign ((result 0)))
        (return)))
    (assign ((i 0)))
    (while
      (< i n)
      (sequence
        (assign ((j 0)))
        (while
          (< j m)
          (sequence
            (assign ((k (+ k 1))))
            (assign ((j (+ j 1))))))
        (assign ((i (+ i 1))))))
    (assert (<= 100 k))
    (assign ((result 0)))
    (return)))
