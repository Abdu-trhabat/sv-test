(define-proc
  main
  ()
  ((result Int))
  ((n Int) (sum Int) (i Int))
  (sequence
    (havoc (n))
    (if
      (not
        (and (<= 1 n) (<= n 1000)))
      (sequence
        (assign ((result 0)))
        (return)))
    (assign ((sum 0)))
    (assign ((i 1)))
    (while
      (<= i n)
      (sequence
        (assign ((sum (+ sum i))))
        (assign ((i (+ i 1))))))
    (assert
      (= (* 2 sum) (* n (+ n 1))))
    (assign ((result 0)))
    (return)))
