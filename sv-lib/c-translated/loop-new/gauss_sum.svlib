(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((n Int) (sum Int) (i Int))
  (!
    (sequence
      (havoc n)
      (if (not (and (<= 1 n) (<= n 1000))) (sequence (assign (result 0)) (return)))
      (assign (sum 0))
      (assign (i 1))
      (!
        (while
          (<= i n)
          (sequence (assign (sum (+ sum i))) (assign (i (+ i 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= (* 2 sum) (* n (+ n 1))))

(verify-call main ())

(get-witness)
