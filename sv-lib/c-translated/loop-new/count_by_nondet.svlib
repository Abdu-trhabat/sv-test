(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((i Int) (k Int) (j Int))
  (!
    (sequence
      (assign (i 0))
      (assign (k 0))
      (!
        (while
          (< i 1000000)
          (sequence
            (if (not (and (<= 1 j) (< j 1000000))) (sequence (assign (result 0)) (return)))
            (assign (i (+ i j)))
            (assign (k (+ k 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (<= k 1000000))

(verify-call main ())

(get-witness)
