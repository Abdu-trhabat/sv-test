(define-proc
  main
  ()
  ((result Int))
  ((i Int) (k Int) (j Int))
  (sequence
    (assign ((i 0)))
    (assign ((k 0)))
    (while
      (< i 1000000)
      (sequence
        (if
          (not
            (and (<= 1 j) (< j 1000000)))
          (sequence
            (assign ((result 0)))
            (return)))
        (assign ((i (+ i j))))
        (assign ((k (+ k 1))))))
    (assert (<= k 1000000))
    (assign ((result 0)))
    (return)))
