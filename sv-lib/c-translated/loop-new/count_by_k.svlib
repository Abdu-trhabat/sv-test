(define-proc
  main
  ()
  ((result Int))
  ((i Int) (k Int))
  (sequence
    (havoc (k))
    (if
      (not
        (and (<= 0 k) (<= k 10)))
      (sequence
        (assign ((result 0)))
        (return)))
    (assign ((i 0)))
    (while
      (< i (* 1000000 k))
      (assign ((i (+ i k)))))
    (assert (= i (* 1000000 k)))
    (assign ((result 0)))
    (return)))
