(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((i Int))
  (!
    (sequence
      (assign (i 0))
      (!
        (while (< i 1000000) (assign (i (+ i 2))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= i 1000000))

(verify-call main ())

(get-witness)
