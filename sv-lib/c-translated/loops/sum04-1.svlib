(define-proc
  main
  ()
  ((result Int))
  ((i Int) (sn Int))
  (sequence
    (assign ((sn 0)))
    (assign ((i 1)))
    (while
      (<= i 8)
      (sequence
        (if
          (< i 4)
          (assign ((sn (+ sn 2)))))
        (assign ((i (+ i 1))))))
    (assert
      (or (= sn (* 8 2)) (= sn 0)))))
