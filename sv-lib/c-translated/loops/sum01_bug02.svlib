(define-proc
  main
  ()
  ((result Int))
  ((i Int) (j Int) (n Int) (sn Int))
  (sequence
    (assign ((j 10)))
    (assign ((sn 0)))
    (if
      (= n 2147483647)
      (sequence
        (assign ((result 0)))
        (return)))
    (assign ((i 1)))
    (while
      (<= i n)
      (sequence
        (if
          (< i j)
          (assign ((sn (+ sn 2)))))
        (assign ((j (- j 1))))
        (assign ((i (+ i 1))))))
    (assert
      (or (= sn (* n 2)) (= sn 0)))))
