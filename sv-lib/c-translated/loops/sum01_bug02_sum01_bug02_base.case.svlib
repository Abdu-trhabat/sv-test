(set-logic QF_LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((i Int) (n Int) (sn Int))
  (!
    (sequence
      (assign (sn 0))
      (assign (i 1))
      (!
        (while
          (<= i n)
          (sequence
            (assign (sn (+ sn 2)))
            (if (= i 4) (assign (sn (- 10))))
            (assign (i (+ i 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1))
    :tag
    main))

(annotate-tag main-check-1 :check-true (or (= sn (* n 2)) (= sn 0)))

(verify-call main ())

(get-witness)
