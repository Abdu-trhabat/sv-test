(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (sequence
    (if
      (not (<= y 1000000))
      (sequence
        (assign ((result 0)))
        (return)))
    (if
      (< 0 y)
      (while
        (< x 100)
        (assign ((x (+ x y))))))
    (assert
      (or
        (<= y 0)
        (and (< 0 y) (<= 100 x))))
    (assign ((result 0)))
    (return)))
