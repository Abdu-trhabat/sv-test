(set-logic QF_LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((sn Int) (loop1 Int) (n1 Int) (x Int))
  (!
    (sequence
      (assign (sn 0))
      (assign (x 0))
      (!
        (while
          (not (= 1 0))
          (sequence
            (assign (sn (+ sn 2)))
            (assign (x (+ x 1)))
            (! (sequence) :tag main-check-1)))
        :tag
        main-while-1))
    :tag
    main))

(annotate-tag main-check-1 :check-true (or (= sn (* x 2)) (= sn 0)))

(verify-call main ())

(get-witness)
