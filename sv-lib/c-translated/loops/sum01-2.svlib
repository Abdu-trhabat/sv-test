(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((i Int) (n Int) (sn Int))
  (!
    (sequence
      (assign (sn 0))
      (if (not (and (< n 1000) (<= (- 1000) n))) (sequence (assign (result 0)) (return)))
      (assign (i 1))
      (!
        (while
          (<= i n)
          (sequence (assign (sn (+ sn 2))) (assign (i (+ i 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1))
    :tag
    main))

(annotate-tag main-check-1 :check-true (or (= sn (* n 2)) (= sn 0)))

(verify-call main ())

(get-witness)
