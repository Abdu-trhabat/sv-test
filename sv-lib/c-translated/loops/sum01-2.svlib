(define-proc
  main
  ()
  ((result Int))
  ((i Int) (n Int) (sn Int))
  (sequence
    (assign ((sn 0)))
    (if
      (not
        (and (< n 1000) (<= (- 1000) n)))
      (sequence
        (assign ((result 0)))
        (return)))
    (assign ((i 1)))
    (while
      (<= i n)
      (sequence
        (assign ((sn (+ sn 2))))
        (assign ((i (+ i 1))))))
    (assert
      (or (= sn (* n 2)) (= sn 0)))))
