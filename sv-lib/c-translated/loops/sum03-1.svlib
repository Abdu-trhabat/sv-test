(define-proc
  main
  ()
  ((result Int))
  ((sn Int) (loop1 Int) (n1 Int) (x Int))
  (sequence
    (assign ((sn 0)))
    (assign ((x 0)))
    (while
      (not (= 1 0))
      (sequence
        (if
          (< x 10)
          (assign ((sn (+ sn 2)))))
        (assign ((x (+ x 1))))
        (assert
          (or (= sn (* x 2)) (= sn 0)))))))
