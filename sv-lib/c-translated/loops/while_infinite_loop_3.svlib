(define-proc
  eval
  ()
  ()
  ()
  (sequence
    (while
      (not (= 1 0))
      (sequence (assign ((x 0))) (break)))
    (return)))
(define-proc
  main
  ()
  ((result Int))
  ()
  (sequence
    (assign ((x 0)))
    (while
      (not (= 1 0))
      (sequence
        (call eval () ())
        (assert (= x 0))))
    (assert (not (= x 0)))
    (assign ((result 0)))
    (return)))
