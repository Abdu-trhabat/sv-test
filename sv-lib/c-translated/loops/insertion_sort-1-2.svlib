(set-logic ALL)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((SIZE Int) (i Int) (j Int) (k Int) (key Int) (v (Array Int Int)) (nondet_int$1 Int))
  (!
    (sequence
      (if (<= (div 4000000000 4) SIZE) (sequence (assign (result 0)) (return)))
      (assign (j 0))
      (!
        (while
          (< j SIZE)
          (sequence (assign (v (store v j nondet_int$1))) (assign (j (+ j 1)))))
        :tag
        main-while-1)
      (assign (j 1))
      (!
        (while
          (< j SIZE)
          (sequence
            (assign (key (select v j)))
            (assign (i (- j 1)))
            (!
              (while
                (and (<= 0 i) (< key (select v i)))
                (sequence
                  (if
                    (< i 2)
                    (assign (v (store v (+ i 1) (select v i)))))
                  (assign (i (- i 1)))))
              :tag
              main-while-3)
            (assign (v (store v (+ i 1) key)))
            (assign (j (+ j 1)))))
        :tag
        main-while-2)
      (assign (k 1))
      (!
        (while
          (< k SIZE)
          (sequence (! (sequence) :tag main-check-1) (assign (k (+ k 1)))))
        :tag
        main-while-4)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (<= (select v (- k 1)) (select v k)))

(verify-call main ())

(get-witness)
