(define-proc
  main
  ()
  ((result Int))
  ((i Int) (x Int) (n Int))
  (sequence
    (assign ((i 0)))
    (assign ((x 0)))
    (if
      (not (< 0 n))
      (sequence
        (assign ((result 0)))
        (return)))
    (assign ((i 0)))
    (while
      (not (= 1 0))
      (sequence
        (assert (= x 0))
        (assign ((i (+ i 1))))))
    (assert (not (= x 0)))))
