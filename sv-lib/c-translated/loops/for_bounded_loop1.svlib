(define-proc
  main
  ()
  ((result Int))
  ((i Int) (x Int) (y Int) (n Int))
  (sequence
    (assign ((i 0)))
    (assign ((x 0)))
    (assign ((y 0)))
    (if
      (not (< 0 n))
      (sequence
        (assign ((result 0)))
        (return)))
    (assign ((i 0)))
    (while
      (< i n)
      (sequence
        (assign ((x (- x y))))
        (assert (= x 0))
        (havoc (y))
        (if
          (not (not (= y 0)))
          (sequence
            (assign ((result 0)))
            (return)))
        (assign ((x (+ x y))))
        (assert (not (= x 0)))
        (assign ((i (+ i 1))))))
    (assert (= x 0))))
