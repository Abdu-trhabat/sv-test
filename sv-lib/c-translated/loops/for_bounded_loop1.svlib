(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((i Int) (x Int) (y Int) (n Int))
  (!
    (sequence
      (assign (i 0))
      (assign (x 0))
      (assign (y 0))
      (if (not (< 0 n)) (sequence (assign (result 0)) (return)))
      (assign (i 0))
      (!
        (while
          (< i n)
          (sequence
            (assign (x (- x y)))
            (! (sequence) :tag main-check-1)
            (havoc y)
            (if (not (not (= y 0))) (sequence (assign (result 0)) (return)))
            (assign (x (+ x y)))
            (! (sequence) :tag main-check-2)
            (assign (i (+ i 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-3))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= x 0))

(annotate-tag main-check-2 :check-true (not (= x 0)))

(annotate-tag main-check-3 :check-true (= x 0))

(verify-call main ())

(get-witness)
