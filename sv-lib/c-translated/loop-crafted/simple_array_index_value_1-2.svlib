(set-logic QF_ALIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((array (Array Int Int)) (index Int) (tmp Int))
  (!
    (sequence
      (assign (index 0))
      (assign (tmp 0))
      (!
        (while
          (not (= 1 0))
          (sequence
            (havoc index)
            (if (<= 10000 index) (break))
            (assign (array (store array index index)))
            (assign (tmp index))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1))
    :tag
    main))

(annotate-tag
  main-check-1
  :check-true
  (and (< tmp 10000) (= (select array tmp) tmp)))

(verify-call main ())

(get-witness)
