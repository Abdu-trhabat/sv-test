(define-proc
  main
  ()
  ((result Int))
  ((i Int) (j Int) (k Int))
  (sequence
    (assign ((i 0)))
    (assign ((j 0)))
    (assign ((k 0)))
    (while
      (< k 268435455)
      (sequence
        (assign ((i (+ i 1))))
        (assign ((j (+ j 2))))
        (assign ((k (+ k 3))))
        (assert (= k (+ i j)))))))
