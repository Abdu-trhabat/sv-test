(set-logic QF_ALIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((array (Array Int Int)) (index Int) (tmp Int))
  (!
    (sequence
      (assign (index 0))
      (!
        (while
          (< index 10000)
          (sequence
            (assume (< index tmp))
            (assign (array (store array index tmp)))
            (assign (index (+ index 1)))))
        :tag
        main-while-1)
      (assign (index 0))
      (!
        (while
          (< index 10000)
          (sequence (! (sequence) :tag main-check-1) (assign (index (+ index 1)))))
        :tag
        main-while-2))
    :tag
    main))

(annotate-tag main-check-1 :check-true (< index (select array index)))

(verify-call main ())

(get-witness)
