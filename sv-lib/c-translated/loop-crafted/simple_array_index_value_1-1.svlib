(define-proc
  main
  ()
  ((result Int))
  ((array (Array Int Int))
    (index Int))
  (sequence
    (assign ((index 0)))
    (while
      (< index 1000)
      (sequence
        (assign
          ((array
              (store array index (mod index 2)))))
        (assign
          ((index (+ index 1))))))
    (assign ((index 0)))
    (while
      (< index 1000)
      (sequence
        (if
          (= (mod index 2) 0)
          (assert
            (= (select array index) 0))
          (assert
            (not
              (= (select array index) 0))))
        (assign
          ((index (+ index 1))))))))
