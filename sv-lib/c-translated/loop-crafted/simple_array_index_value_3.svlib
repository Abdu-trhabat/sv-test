(define-proc
  main
  ()
  ((result Int))
  ((array (Array Int Int))
    (index Int)
    (tmp Int))
  (sequence
    (assign ((index 0)))
    (assign ((tmp 0)))
    (while
      (< index 10000)
      (sequence
        (assign
          ((array
              (store array index tmp))))
        (assign
          ((index (+ index 1))))
        (assign ((tmp (+ tmp 2))))))
    (assign ((index 0)))
    (while
      (< index 10000)
      (sequence
        (assert
          (or
            (= (select array index) (* 2 index))
            (= (select array index) 0)))
        (assign
          ((index (+ index 1))))))))
