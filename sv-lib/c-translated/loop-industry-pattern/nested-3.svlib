(set-logic QF_LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(declare-var last Int)

(define-proc
  main
  ()
  ((result Int))
  ((a Int) (b Int) (c Int) (st Int))
  (!
    (sequence
      (assign (last 0))
      (havoc last)
      (assign (a 0))
      (assign (b 0))
      (assign (c 0))
      (assign (st 0))
      (!
        (while
          (not (= 1 0))
          (sequence
            (assign (st 1))
            (assign (c 0))
            (!
              (while
                (< c 200000)
                (sequence (if (= c last) (assign (st 0))) (assign (c (+ c 1)))))
              :tag
              main-while-2)
            (if
              (and (= st 0) (= c (+ last 1)))
              (sequence (assign (a (+ a 3))) (assign (b (+ b 3))))
              (sequence (assign (a (+ a 2))) (assign (b (+ b 2)))))
            (if (and (= c last) (= st 0)) (assign (a (+ a 1))))
            (! (sequence) :tag main-check-1)))
        :tag
        main-while-1))
    :tag
    main))

(annotate-tag main-check-1 :check-true (and (= a b) (= c 200000)))

(verify-call main ())

(get-witness)
