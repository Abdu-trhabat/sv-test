(set-logic QF_NIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int) (nondet_int$1 Int) (nondet_int$2 Int))
  (!
    (sequence
      (assign (y 1))
      (!
        (while
          true
          (sequence
            (if (not (not (= nondet_int$1 0))) (break))
            (if
              (= (mod x 3) 1)
              (sequence (assign (x (+ x 2))) (assign (y 0)))
              (if
                (= (mod x 3) 2)
                (sequence (assign (x (+ x 1))) (assign (y 0)))
                (if
                  (not (= nondet_int$2 0))
                  (sequence (assign (x (+ x 4))) (assign (y 1)))
                  (sequence (assign (x (+ x 5))) (assign (y 1))))))))
        :tag
        main-while-1)
      (if (= y 0) (! (sequence) :tag main-check-1))
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= (mod x 3) 0))

(verify-call main ())

(get-witness)
