(set-logic QF_NIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((i Int) (j Int) (a Int) (b Int) (flag Int) (nondet_int$1 Int))
  (!
    (sequence
      (assign (a 0))
      (assign (b 0))
      (assign (j 1))
      (if (not (= flag 0)) (assign (i 0)) (assign (i 1)))
      (!
        (while
          true
          (sequence
            (if (not (not (= nondet_int$1 0))) (break))
            (assign (a (+ a 1)))
            (assign (b (+ b (- j i))))
            (assign (i (+ i 2)))
            (if (= (mod i 2) 0) (assign (j (+ j 2))) (assign (j (+ j 1))))))
        :tag
        main-while-1)
      (if (not (= flag 0)) (! (sequence) :tag main-check-1))
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= a b))

(verify-call main ())

(get-witness)
