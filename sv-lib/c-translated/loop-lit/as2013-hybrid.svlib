(define-proc
  main
  ()
  ((result Int))
  ((i Int) (j Int))
  (sequence
    (assign ((i 0)))
    (while
      (not (= 1 0))
      (sequence
        (assign ((i (+ i 1))))
        (assign ((j 0)))
        (while
          (< j 10)
          (sequence
            (assert (<= 0 i))
            (assert (<= i 10))
            (assign ((j (+ j 1))))))
        (if (< 9 i) (assign ((i 0))))))
    (assign ((result 0)))
    (return)))
