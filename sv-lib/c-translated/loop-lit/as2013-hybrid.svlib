(set-logic QF_LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((i Int) (j Int))
  (!
    (sequence
      (assign (i 0))
      (!
        (while
          (not (= 1 0))
          (sequence
            (assign (i (+ i 1)))
            (assign (j 0))
            (!
              (while
                (< j 10)
                (sequence
                  (! (sequence) :tag main-check-1)
                  (! (sequence) :tag main-check-2)
                  (assign (j (+ j 1)))))
              :tag
              main-while-2)
            (if (< 9 i) (assign (i 0)))))
        :tag
        main-while-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (<= 0 i))

(annotate-tag main-check-2 :check-true (<= i 10))

(verify-call main ())

(get-witness)
