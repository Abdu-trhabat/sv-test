(define-proc
  main
  ()
  ((result Int))
  ((v Int))
  (sequence
    (assign ((v 1)))
    (while
      (<= v 50)
      (sequence
        (assert (<= 1 v))
        (assign ((v (+ v 2))))
        (assert (<= v 52))))
    (assert (<= 51 v))
    (assert (<= v 52))
    (assign ((result 0)))
    (return)))
