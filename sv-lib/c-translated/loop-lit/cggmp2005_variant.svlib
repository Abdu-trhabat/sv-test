(define-proc
  main
  ()
  ((result Int))
  ((lo Int) (mid Int) (hi Int))
  (sequence
    (assign ((lo 0)))
    (havoc (mid))
    (if
      (not
        (and (< 0 mid) (<= mid 1000000)))
      (sequence
        (assign ((result 0)))
        (return)))
    (assign ((hi (* 2 mid))))
    (while
      (< 0 mid)
      (sequence
        (assign ((lo (+ lo 1))))
        (assign ((hi (- hi 1))))
        (assign ((mid (- mid 1))))))
    (assert (= lo hi))
    (assign ((result 0)))
    (return)))
