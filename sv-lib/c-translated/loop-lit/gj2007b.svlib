          (not (= nondet_int$1 0))
          (assign ((m x))))
        (assign ((x (+ x 1))))))
    (assert
      (or (<= 0 m) (<= n 0)))
    (assert
      (or (< m n) (<= n 0)))
    (assign ((result 0)))
    (return)))
