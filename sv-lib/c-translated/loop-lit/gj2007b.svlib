(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((x Int) (m Int) (n Int) (nondet_int$1 Int))
  (!
    (sequence
      (assign (x 0))
      (assign (m 0))
      (!
        (while
          (< x n)
          (sequence
            (if (not (= nondet_int$1 0)) (assign (m x)))
            (assign (x (+ x 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (! (sequence) :tag main-check-2)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (or (<= 0 m) (<= n 0)))

(annotate-tag main-check-2 :check-true (or (< m n) (<= n 0)))

(verify-call main ())

(get-witness)
