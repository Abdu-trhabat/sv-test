(set-logic QF_LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int) (x$2 Bool) (nondet_int$1 Int))
  (!
    (sequence
      (assign (x 1))
      (assign (y 0))
      (assign (x$2 (< y 1000)))
      (if x$2 (assign (x$2 (not (= nondet_int$1 0)))))
      (!
        (while
          true
          (sequence (if (not x$2) (break)) (assign (x (+ x y))) (assign (y (+ y 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (<= y x))

(verify-call main ())

(get-witness)
