(define-proc
  main
  ()
  ((result Int))
  ((i Int) (j Int))
  (sequence
    (assign ((i 0)))
    (while
      (< i 100)
      (sequence
        (assign ((j 0)))
        (while
          (< j 100)
          (sequence
            (assign ((j (+ j 1))))
            (assert (<= j 100))))
        (assert (= j 100))
        (assign ((i (+ i 1))))
        (assert (<= i 100))))
    (assert (= i 100))
    (assign ((result 0)))
    (return)))
