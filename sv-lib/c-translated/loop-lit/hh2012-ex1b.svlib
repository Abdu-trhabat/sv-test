(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((i Int) (j Int))
  (!
    (sequence
      (assign (i 0))
      (!
        (while
          (< i 100)
          (sequence
            (assign (j 0))
            (!
              (while
                (< j 100)
                (sequence (assign (j (+ j 1))) (! (sequence) :tag main-check-1)))
              :tag
              main-while-2)
            (! (sequence) :tag main-check-2)
            (assign (i (+ i 1)))
            (! (sequence) :tag main-check-3)))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-4)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (<= j 100))

(annotate-tag main-check-2 :check-true (= j 100))

(annotate-tag main-check-3 :check-true (<= i 100))

(annotate-tag main-check-4 :check-true (= i 100))

(verify-call main ())

(get-witness)
