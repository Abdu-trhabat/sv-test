(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (sequence
    (assign ((x 0)))
    (assign ((y 50)))
    (while
      (< x 100)
      (if
        (< x 50)
        (assign ((x (+ x 1))))
        (sequence
          (assign ((x (+ x 1))))
          (assign ((y (+ y 1)))))))
    (assert (= y 100))
    (assign ((result 0)))
    (return)))
