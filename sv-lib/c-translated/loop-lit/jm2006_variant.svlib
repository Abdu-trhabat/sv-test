(define-proc
  main
  ()
  ((result Int))
  ((i Int) (j Int) (x Int) (y Int) (z Int))
  (sequence
    (havoc (i))
    (havoc (j))
    (if
      (not
        (and (<= 0 i) (<= i 1000000)))
      (sequence
        (assign ((result 0)))
        (return)))
    (if
      (not (<= 0 j))
      (sequence
        (assign ((result 0)))
        (return)))
    (assign ((x i)))
    (assign ((y j)))
    (assign ((z 0)))
    (while
      (not (= x 0))
      (sequence
        (assign ((x (- x 1))))
        (assign ((y (- y 2))))
        (assign ((z (+ z 1))))))
    (if (= i j) (assert (= y (- z))))
    (assign ((result 0)))
    (return)))
