(define-proc
  main
  ()
  ((result Int))
  ((a Int) (b Int) (res Int) (cnt Int))
  (sequence
    (if
      (not (<= a 1000000))
      (sequence
        (assign ((result 0)))
        (return)))
    (if
      (not
        (and (<= 0 b) (<= b 1000000)))
      (sequence
        (assign ((result 0)))
        (return)))
    (assign ((res a)))
    (assign ((cnt b)))
    (while
      (< 0 cnt)
      (sequence
        (assign ((cnt (- cnt 1))))
        (assign ((res (+ res 1))))))
    (assert (= res (+ a b)))
    (assign ((result 0)))
    (return)))
