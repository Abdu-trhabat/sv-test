(set-logic QF_LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((a Int) (b Int) (res Int) (cnt Int))
  (!
    (sequence
      (if (not (<= a 1000000)) (sequence (assign (result 0)) (return)))
      (if (not (and (<= 0 b) (<= b 1000000))) (sequence (assign (result 0)) (return)))
      (assign (res a))
      (assign (cnt b))
      (!
        (while
          (< 0 cnt)
          (sequence (assign (cnt (- cnt 1))) (assign (res (+ res 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= res (+ a b)))

(verify-call main ())

(get-witness)
