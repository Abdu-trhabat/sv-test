(set-logic QF_LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (!
    (sequence
      (assign (x 0))
      (assign (y 0))
      (!
        (while
          (not (= 1 0))
          (sequence
            (if (< x 50) (assign (y (+ y 1))) (assign (y (- y 1))))
            (if (< y 0) (break))
            (assign (x (+ x 1)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= x 100))

(verify-call main ())

(get-witness)
