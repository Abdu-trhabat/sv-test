(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (sequence
    (assign ((x 0)))
    (assign ((y 0)))
    (while
      (not (= 1 0))
      (sequence
        (if
          (< x 50)
          (assign ((y (+ y 1))))
          (assign ((y (- y 1)))))
        (if (< y 0) (break))
        (assign ((x (+ x 1))))))
    (assert (= x 100))
    (assign ((result 0)))
    (return)))
