(define-proc
  main
  ()
  ((result Int))
  ((x Int) (y Int))
  (sequence
    (assign ((x (- 50))))
    (havoc (y))
    (if
      (not
        (and (< (- 1000) y) (< y 1000000)))
      (sequence
        (assign ((result 0)))
        (return)))
    (while
      (< x 0)
      (sequence
        (assign ((x (+ x y))))
        (assign ((y (+ y 1))))))
    (assert (< 0 y))
    (assign ((result 0)))
    (return)))
