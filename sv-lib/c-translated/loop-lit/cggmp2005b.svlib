(define-proc
  main
  ()
  ((result Int))
  ((i Int) (j Int) (k Int))
  (sequence
    (assign ((i 0)))
    (assign ((k 9)))
    (assign ((j (- 100))))
    (while
      (<= i 100)
      (sequence
        (assign ((i (+ i 1))))
        (while
          (< j 20)
          (assign ((j (+ i j)))))
        (assign ((k 4)))
        (while
          (<= k 3)
          (assign ((k (+ k 1)))))))
    (assert (= k 4))
    (assign ((result 0)))
    (return)))
