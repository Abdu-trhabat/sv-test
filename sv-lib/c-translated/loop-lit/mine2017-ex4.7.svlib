(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((x Int) (nondet_bool$1 Int) (nondet_bool$2 Int))
  (!
    (sequence
      (assign (x 0))
      (!
        (while
          true
          (sequence
            (if (not (= nondet_bool$1 0)) (break))
            (! (sequence) :tag main-check-1)
            (! (sequence) :tag main-check-2)
            (if
              (= nondet_bool$2 0)
              (sequence (assign (x (+ x 1))) (if (< 40 x) (assign (x 0)))))))
        :tag
        main-while-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (<= 0 x))

(annotate-tag main-check-2 :check-true (<= x 40))

(verify-call main ())

(get-witness)
