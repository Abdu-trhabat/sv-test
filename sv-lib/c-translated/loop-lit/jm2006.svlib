(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((i Int) (j Int) (x Int) (y Int))
  (!
    (sequence
      (havoc i)
      (havoc j)
      (if (not (and (<= 0 i) (<= 0 j))) (sequence (assign (result 0)) (return)))
      (assign (x i))
      (assign (y j))
      (!
        (while
          (not (= x 0))
          (sequence (assign (x (- x 1))) (assign (y (- y 1)))))
        :tag
        main-while-1)
      (if (= i j) (! (sequence) :tag main-check-1))
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= y 0))

(verify-call main ())

(get-witness)
