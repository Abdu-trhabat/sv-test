(define-proc
  main
  ()
  ((result Int))
  ((i Int) (j Int) (x Int) (y Int))
  (sequence
    (havoc (i))
    (havoc (j))
    (if
      (not
        (and (<= 0 i) (<= 0 j)))
      (sequence
        (assign ((result 0)))
        (return)))
    (assign ((x i)))
    (assign ((y j)))
    (while
      (not (= x 0))
      (sequence
        (assign ((x (- x 1))))
        (assign ((y (- y 1))))))
    (if (= i j) (assert (= y 0)))
    (assign ((result 0)))
    (return)))
