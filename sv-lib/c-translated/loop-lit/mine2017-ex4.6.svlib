(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((x Int))
  (!
    (sequence
      (assign (x 40))
      (!
        (while
          (not (= x 0))
          (sequence
            (! (sequence) :tag main-check-1)
            (assign (x (- x 1)))
            (! (sequence) :tag main-check-2)))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-3)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (<= x 40))

(annotate-tag main-check-2 :check-true (<= 0 x))

(annotate-tag main-check-3 :check-true (= x 0))

(verify-call main ())

(get-witness)
