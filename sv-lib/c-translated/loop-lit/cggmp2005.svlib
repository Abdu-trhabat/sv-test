(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((i Int) (j Int))
  (!
    (sequence
      (assign (i 1))
      (assign (j 10))
      (!
        (while
          (<= i j)
          (sequence (assign (i (+ i 2))) (assign (j (+ (- 1) j)))))
        :tag
        main-while-1)
      (! (sequence) :tag main-check-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (= j 6))

(verify-call main ())

(get-witness)
