(set-logic QF_LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((n Int) (nondet_bool$1 Int))
  (!
    (sequence
      (assign (n 0))
      (!
        (while
          (not (= 1 0))
          (sequence
            (! (sequence) :tag main-check-1)
            (if
              (not (= nondet_bool$1 0))
              (if
                (< n 60)
                (assign (n (+ n 1)))
                (sequence (! (sequence) :tag main-check-2) (assign (n 0)))))))
        :tag
        main-while-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (<= n 60))

(annotate-tag main-check-2 :check-true (= n 60))

(verify-call main ())

(get-witness)
