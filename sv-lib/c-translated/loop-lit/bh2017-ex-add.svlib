(set-logic QF_LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  main
  ()
  ((result Int))
  ((m Int)
    (n Int)
    (nondet_bool$1 Int)
    (nondet_bool$2 Int)
    (nondet_bool$4 Int)
    (nondet_bool$5 Int))
  (!
    (sequence
      (assign (m 0))
      (assign (n 0))
      (!
        (while
          (not (= 1 0))
          (sequence
            (! (sequence) :tag main-check-1)
            (! (sequence) :tag main-check-2)
            (if
              (not (= nondet_bool$1 0))
              (if
                (not (= nondet_bool$2 0))
                (if
                  (< m 60)
                  (assign (m (+ m 1)))
                  (sequence (! (sequence) :tag main-check-3) (assign (m 0))))))
            (if
              (not (= nondet_bool$4 0))
              (if
                (not (= nondet_bool$5 0))
                (if
                  (< n 60)
                  (assign (n (+ n 1)))
                  (sequence (! (sequence) :tag main-check-4) (assign (n 0))))))))
        :tag
        main-while-1)
      (assign (result 0))
      (return))
    :tag
    main))

(annotate-tag main-check-1 :check-true (<= m 60))

(annotate-tag main-check-2 :check-true (<= n 60))

(annotate-tag main-check-3 :check-true (= m 60))

(annotate-tag main-check-4 :check-true (= n 60))

(verify-call main ())

(get-witness)
