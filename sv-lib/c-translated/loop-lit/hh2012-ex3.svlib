(define-proc
  main
  ()
  ((result Int))
  ((i Int) (j Int))
  (sequence
    (assign ((i 0)))
    (while
      (< i 4)
      (sequence
        (assign ((j 0)))
        (while
          (< j 4)
          (sequence
            (assign ((i (+ i 1))))
            (assign ((j (+ j 1))))
            (assert (<= 0 j))
            (assert (<= j i))
            (assert (<= i (+ j 3)))
            (assert (<= j 4))))
        (assert (<= 0 j))
        (assert (<= j i))
        (assert (<= i (+ j 3)))
        (assert (<= j 4))
        (assign ((i (+ (- i j) 1))))))
    (assign ((result 0)))
    (return)))
