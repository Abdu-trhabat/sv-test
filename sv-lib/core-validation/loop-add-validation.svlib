(set-logic QF_LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(set-logic LIA)

(define-proc
  add
  ((x0 Int) (y0 Int))
  ((x Int))
  ((y Int))
  (!
    (!
      (sequence
        (assign (x x0) (y y0))
        (!
          (!
            (while (< 0 y) (assign (x (+ x 1)) (y (- y 1))))
            :tag
            add-while-1)
          :tag
          while-1))
      :tag
      proc-add)
    :tag
    add))

(annotate-tag proc-add :requires (<= 0 y0) :ensures (= x (+ x0 y0)))

(annotate-tag while-1 :invariant (and (<= 0 y) (= (+ x y) (+ x0 y0))))

(declare-const x0 Int)

(declare-const y0 Int)

(! (sequence) :tag None-check-1)

(verify-call add (x0 y0))

(annotate-tag None-check-1 :check-true (<= 0 y0))

(verify-call main ())

(get-witness)
