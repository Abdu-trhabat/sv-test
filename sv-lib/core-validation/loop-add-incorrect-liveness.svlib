(set-logic LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  add
  ((x0 Int) (y0 Int))
  ((x Int))
  ((y Int))
  (! (sequence
       (assign (x x0) (y y0))
       (! (while
            (< 0 y)
            (sequence
              (assign
                (x (+ x 1)))
              (if (< 1 y)
                (assign
                  (y (- y 1))))))
        :tag while-loop))
    :tag proc-add))

(annotate-tag
  proc-add
  :requires (<= 0 y0)
  :ensures  (= x (+ x0 y0)))

(annotate-tag while-loop :not-live)

(declare-const x1 Int)
(declare-const y1 Int)

(select-trace
  (model
    (define-fun x1 () Int)
    (define-fun y1 () Int))
  (init-global-vars)
  (entry-proc add)
  (steps
    (init-proc-vars add
      (x 1) (y 1)))
  (incorrect-annotation
    while-loop
    :not-live)
  (using-annotation
    while-loop
    :invariant (= y 0)
  ))
(verify-call add (x1 y1))

(get-witness)