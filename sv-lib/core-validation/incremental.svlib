(set-logic LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(define-proc
    increment
    ((x Int))
    ((y Int))
    ()
    (!
        (sequence
            (assign (y (+ x 2)))
            (! (sequence) :check-true (> x y)))
        :tag proc-increment))

(annotate-tag
    proc-increment
    :ensures  (= y (+ x 1)))

(declare-const x Int)

(verify-call
    increment (x))

(get-witness)