(set-logic QF_LIA)

(set-option :produce-violation-witnesses true)

(set-option :produce-correctness-witnesses true)

(set-option :witness-output-channel "./witness.svlib")

(set-info :format-version "1.0")

(set-logic LIA)

(define-proc
  upto
  ((n Int))
  ((i Int))
  ()
  (!
    (!
      (sequence
        (assign i 0)
        (!
          (! (while (< i n) (assign i (+ i 1))) :tag upto-while-1)
          :tag
          while-1))
      :tag
      proc-upto)
    :tag
    upto))

(annotate-tag proc-upto :ensures (= i n))

(annotate-tag while-1 :not -live)

(annotate-tag proc-upto :requires (<= 0 n))

(annotate-tag while-1 :decreases (- n i) :invariant (and (<= 0 i) (<= i n)))

(declare-const n Int)

(! (sequence) :tag None-check-1)

(verify-call upto (n))

(annotate-tag None-check-1 :check-true (<= 0 n))

(verify-call main ())

(get-witness)
