# This is a Docker image for running the sanity checks.
# It should be pushed to registry.gitlab.com/sosy-lab/benchmarking/sv-benchmarks/ci/sanity-checks
# and will be used by CI as declared in .gitlab-ci.yml.
#
# Commands for updating the image:
# docker build --pull -t registry.gitlab.com/sosy-lab/benchmarking/sv-benchmarks/ci/sanity-checks:latest - < .Dockerfile.sanity-checks
# docker push registry.gitlab.com/sosy-lab/benchmarking/sv-benchmarks/ci/sanity-checks

FROM python:3

RUN apt install -y wget \
  unzip

RUN pip3 install \
  coloredlogs \
  pyyaml \
  lxml \
  pycparser \
  jsonschema

# Currently the witness linter is not available as a python package
RUN wget https://zenodo.org/records/10213801/files/WitnessLint-2.0.2.zip -O WitnessLint.zip
RUN unzip WitnessLint.zip
RUN rm WitnessLint.zip
ENV PATH="${PATH}:/lint"
