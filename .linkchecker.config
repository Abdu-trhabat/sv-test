[checking]
recursionlevel=1

[filtering]
ignore = https://gitlab.com/sosy-lab/benchmarking/sv-benchmarks/-/issues/new
ignorewarnings = http-redirected

[output]
status=0
ignoreerrors =
  https://dl.acm.org/.*

[text]
parts=realurl,result,extern,base,name,parenturl,info,warning,url,outro
